usermod -aG sudo $USER
nano /etc/sudoers
sudo usermod -L root

sudo apt update && \
sudo apt install -y netselect-apt && \
sudo netselect-apt stable && \
sudo sed -i 's/main contrib/main contrib non-free non-free-firmware/g' sources.list && \
sudo mv sources.list /etc/apt/sources.list

sudo apt update && sudo apt upgrade -y && sudo apt install -y \
fish git firefox-esr chromium sway swaylock foot slurp grim imv mpv wmenu lf \
mako-notifier brightnessctl pipewire pipewire-pulse wireplumber pipewire-alsa \
pamixer pavucontrol ufw intel-microcode linux-headers-amd64 firmware-linux \
firmware-misc-nonfree kanshi unzip zip lm-sensors tlp tlp-rdw nmap ffmpeg chafa \
libglib2.0-bin xdg-desktop-portal-wlr curl neovim build-essential ripgrep zathura zathura-pdf-poppler \
fd-find python3-pip python3-venv htop fastfetch qtwayland5 qt6-wayland adwaita-qt qt6-gtk-platformtheme

sudo systemctl enable --now ufw
sudo ufw default deny incoming
sudo ufw default allow outgoing
sudo ufw enable
sudo ufw status verbose

systemctl --user --now enable pipewire.socket pipewire-pulse.socket wireplumber.service
sudo sensors-detect --auto

mkdir -p ~/.config/{fish,nvim,kanshi,lf,sway,foot,zathura} ~/.themes ~/.icons ~/Pictures/{Wallpapers,Screenshots}
touch ~/.config/nvim/init.lua ~/.config/kanshi/config ~/.config/lf/{lfrc,previewer.sh} ~/.config/sway/{bar.sh,config} ~/.config/foot/foot.ini ~/.config/zathura/zathurarc
chmod +x ~/.config/lf/previewer.sh ~/.config/sway/bar.sh

fish_config
echo 'set -g fish_greeting ""

function happ
    env LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libwayland-client.so.0 /usr/bin/happ $argv
end' > ~/.config/fish/config.fish

sudo nvim /etc/tlp.conf
sudo tlp start
