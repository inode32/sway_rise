usermod -aG sudo $USER
nano /etc/sudoers
sudo usermod -L root

sudo apt update && sudo apt upgrade -y && sudo apt install -y \
fish git firefox-esr sway swaylock foot slurp grim imv wl-clipboard clipman wmenu \
mako-notifier brightnessctl pipewire pipewire-pulse wireplumber pipewire-alsa \
pamixer pavucontrol ufw intel-microcode linux-headers-amd64 firmware-linux \
firmware-misc-nonfree kanshi unzip zip lm-sensors tlp tlp-rdw nmap tcpdump \
libglib2.0-bin xdg-desktop-portal-wlr curl neovim build-essential ripgrep \
fd-find python3-pip python3-venv htop fastfetch

sudo mkdir /boot/grub/themes
sudo nvim /etc/default/grub
GRUB_THEME="/boot/grub/themes/thinkpad/theme.txt"
sudo update-grub

sudo nvim /etc/apt/sources.list
deb http://deb.debian.org/debian/ stable main non-free non-free-firmware contrib
deb http://security.debian.org/debian-security stable-security main non-free non-free-firmware contrib
deb http://deb.debian.org/debian/ stable-updates main non-free non-free-firmware contrib
sudo apt update

systemctl enable --now ufw
sudo ufw default deny incoming
sudo ufw default allow outgoing
sudo ufw enable
sudo ufw status verbose

systemctl --user --now enable pipewire.socket pipewire-pulse.socket wireplumber.service
sudo sensors-detect


